# EditorConfig —— 跨编辑器统一基础书写规则（换行符 / 编码 / 缩进 / 末尾换行）
# 编辑器支持：VS Code 需装 EditorConfig 扩展，JetBrains 系原生支持；官网 editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
