{
  "components": {
    "schemas": {
      "ConfigResponse": {
        "description": "GET /api/config 的响应体——密钥只报来源、绝不回内容。",
        "properties": {
          "api_key_configured": {
            "title": "Api Key Configured",
            "type": "boolean"
          },
          "base_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Base Url"
          },
          "key_source": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Key Source"
          },
          "model": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model"
          }
        },
        "required": [
          "base_url",
          "model",
          "api_key_configured",
          "key_source"
        ],
        "title": "ConfigResponse",
        "type": "object"
      },
      "ConfigUpdateRequest": {
        "description": "PUT /api/config 的请求体——api_key 缺省沿用现有密钥（不强迫重输）。",
        "properties": {
          "api_key": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Api Key"
          },
          "base_url": {
            "title": "Base Url",
            "type": "string"
          },
          "model": {
            "title": "Model",
            "type": "string"
          }
        },
        "required": [
          "base_url",
          "model"
        ],
        "title": "ConfigUpdateRequest",
        "type": "object"
      },
      "ErrorDetail": {
        "description": "错误响应的统一形状——所有域错误都长这样（`{\"detail\": \"一句话\"}`）。\n\n各端点在 `responses=` 里引用它，把错误路径写进 OpenAPI 契约：\n前端生成类型时才能覆盖错误体，而不是只看到成功路径。",
        "properties": {
          "detail": {
            "title": "Detail",
            "type": "string"
          }
        },
        "required": [
          "detail"
        ],
        "title": "ErrorDetail",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HistoryMessageView": {
        "description": "一条历史消息。",
        "properties": {
          "attachment": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Attachment"
          },
          "role": {
            "title": "Role",
            "type": "string"
          },
          "text": {
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "role",
          "text",
          "attachment"
        ],
        "title": "HistoryMessageView",
        "type": "object"
      },
      "LabelRequest": {
        "description": "POST /api/label 的请求体。",
        "properties": {
          "image_base64": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "图片（data URL 或纯 base64）；缺省纯文本轮",
            "title": "Image Base64"
          },
          "image_name": {
            "default": "image.png",
            "description": "图片原始文件名",
            "title": "Image Name",
            "type": "string"
          },
          "instruction": {
            "default": "",
            "description": "打标指令（纯图轮可空）",
            "title": "Instruction",
            "type": "string"
          },
          "prompt_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "基础提示词名称；续接时缺省沿用会话设置",
            "title": "Prompt Name"
          },
          "session_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "续接的会话 id；缺省新建",
            "title": "Session Id"
          },
          "skill_names": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "description": "启用的 skill 清单；缺省沿用会话设置",
            "title": "Skill Names"
          }
        },
        "title": "LabelRequest",
        "type": "object"
      },
      "LabelResponse": {
        "description": "POST /api/label 的响应体。",
        "properties": {
          "caption": {
            "title": "Caption",
            "type": "string"
          },
          "session_id": {
            "title": "Session Id",
            "type": "string"
          }
        },
        "required": [
          "session_id",
          "caption"
        ],
        "title": "LabelResponse",
        "type": "object"
      },
      "PromptFull": {
        "description": "提示词全文。",
        "properties": {
          "body": {
            "title": "Body",
            "type": "string"
          },
          "description": {
            "title": "Description",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "name",
          "description",
          "body"
        ],
        "title": "PromptFull",
        "type": "object"
      },
      "PromptInfo": {
        "description": "提示词条目（列表项）。",
        "properties": {
          "description": {
            "title": "Description",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "name",
          "description"
        ],
        "title": "PromptInfo",
        "type": "object"
      },
      "PromptSaveRequest": {
        "description": "PUT /api/prompts/{name} 的请求体。",
        "properties": {
          "body": {
            "title": "Body",
            "type": "string"
          },
          "description": {
            "default": "",
            "title": "Description",
            "type": "string"
          }
        },
        "required": [
          "body"
        ],
        "title": "PromptSaveRequest",
        "type": "object"
      },
      "SessionSnapshotResponse": {
        "description": "GET /api/sessions/* 的响应体（恢复会话的完整快照）。",
        "properties": {
          "messages": {
            "items": {
              "$ref": "#/components/schemas/HistoryMessageView"
            },
            "title": "Messages",
            "type": "array"
          },
          "session_id": {
            "title": "Session Id",
            "type": "string"
          },
          "settings": {
            "$ref": "#/components/schemas/SettingsView"
          }
        },
        "required": [
          "session_id",
          "settings",
          "messages"
        ],
        "title": "SessionSnapshotResponse",
        "type": "object"
      },
      "SettingsView": {
        "description": "会话当前设置。",
        "properties": {
          "prompt_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Prompt Name"
          },
          "skill_names": {
            "items": {
              "type": "string"
            },
            "title": "Skill Names",
            "type": "array"
          }
        },
        "required": [
          "prompt_name",
          "skill_names"
        ],
        "title": "SettingsView",
        "type": "object"
      },
      "SkillImportRequest": {
        "description": "POST /api/skills/import 的请求体。",
        "properties": {
          "path": {
            "description": "skill 目录的本地路径（服务端可访问）",
            "title": "Path",
            "type": "string"
          }
        },
        "required": [
          "path"
        ],
        "title": "SkillImportRequest",
        "type": "object"
      },
      "SkillImportResponse": {
        "description": "导入结果。",
        "properties": {
          "description": {
            "title": "Description",
            "type": "string"
          },
          "enabled": {
            "title": "Enabled",
            "type": "boolean"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "total_bytes": {
            "title": "Total Bytes",
            "type": "integer"
          }
        },
        "required": [
          "name",
          "description",
          "enabled",
          "total_bytes"
        ],
        "title": "SkillImportResponse",
        "type": "object"
      },
      "SkillInfo": {
        "description": "skill 条目。",
        "properties": {
          "description": {
            "title": "Description",
            "type": "string"
          },
          "enabled": {
            "title": "Enabled",
            "type": "boolean"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "name",
          "description",
          "enabled"
        ],
        "title": "SkillInfo",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "summary": "AI 打标工具（发图 + 指令产出 caption，支持迭代改写）",
    "title": "Dataset Factory",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/config": {
      "get": {
        "description": "查看当前配置（密钥只报来源与是否已配置，绝不回内容）。",
        "operationId": "get_config_api_config_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConfigResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Get Config",
        "tags": [
          "配置"
        ]
      },
      "put": {
        "description": "更新配置；api_key 缺省沿用现有密钥（Web 表单改 base_url 不必重输密钥）。",
        "operationId": "update_config_api_config_put",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConfigUpdateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDetail"
                }
              }
            },
            "description": "参数不合法 / 未提供密钥"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Update Config",
        "tags": [
          "配置"
        ]
      }
    },
    "/api/label": {
      "post": {
        "description": "跑一轮打标（带 session_id 即续接迭代改写）。",
        "operationId": "label_api_label_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LabelRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LabelResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDetail"
                }
              }
            },
            "description": "输入不合法（图片 base64 / 提示词未选 / 空轮 / 端点配置缺失）"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDetail"
                }
              }
            },
            "description": "会话或提示词不存在"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDetail"
                }
              }
            },
            "description": "会话落盘等内部错误"
          },
          "502": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDetail"
                }
              }
            },
            "description": "模型端点调用失败"
          }
        },
        "summary": "Label",
        "tags": [
          "打标与会话"
        ]
      }
    },
    "/api/prompts": {
      "get": {
        "description": "列出全部提示词。",
        "operationId": "list_all_api_prompts_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/PromptInfo"
                  },
                  "title": "Response List All Api Prompts Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List All",
        "tags": [
          "提示词库"
        ]
      }
    },
    "/api/prompts/{name}": {
      "delete": {
        "description": "删除提示词。",
        "operationId": "remove_api_prompts__name__delete",
        "parameters": [
          {
            "in": "path",
            "name": "name",
            "required": true,
            "schema": {
              "title": "Name",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDetail"
                }
              }
            },
            "description": "提示词不存在"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Remove",
        "tags": [
          "提示词库"
        ]
      },
      "get": {
        "description": "读某条提示词全文。",
        "operationId": "get_one_api_prompts__name__get",
        "parameters": [
          {
            "in": "path",
            "name": "name",
            "required": true,
            "schema": {
              "title": "Name",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PromptFull"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDetail"
                }
              }
            },
            "description": "提示词文件损坏（格式非法）"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDetail"
                }
              }
            },
            "description": "提示词不存在"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get One",
        "tags": [
          "提示词库"
        ]
      },
      "put": {
        "description": "保存提示词（不存在即新建、已存在即覆盖——旧版进 _history 滚动备份）。",
        "operationId": "save_api_prompts__name__put",
        "parameters": [
          {
            "in": "path",
            "name": "name",
            "required": true,
            "schema": {
              "title": "Name",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PromptSaveRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDetail"
                }
              }
            },
            "description": "名称不合法（含路径分隔符等）"
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDetail"
                }
              }
            },
            "description": "提示词超出 32 KiB 字节护栏"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Save",
        "tags": [
          "提示词库"
        ]
      }
    },
    "/api/sessions/latest": {
      "get": {
        "description": "最新会话快照（重启恢复入口）；一个会话都没有时 404。",
        "operationId": "latest_session_api_sessions_latest_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionSnapshotResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDetail"
                }
              }
            },
            "description": "还没有任何会话"
          }
        },
        "summary": "Latest Session",
        "tags": [
          "打标与会话"
        ]
      }
    },
    "/api/sessions/{session_id}": {
      "get": {
        "description": "某会话快照（设置 + 对话历史）。",
        "operationId": "get_session_api_sessions__session_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "session_id",
            "required": true,
            "schema": {
              "title": "Session Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionSnapshotResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDetail"
                }
              }
            },
            "description": "会话不存在"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Session",
        "tags": [
          "打标与会话"
        ]
      }
    },
    "/api/skills": {
      "get": {
        "description": "列出全部 skill（含启用状态）。",
        "operationId": "list_all_api_skills_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/SkillInfo"
                  },
                  "title": "Response List All Api Skills Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List All",
        "tags": [
          "Skill 库"
        ]
      }
    },
    "/api/skills/import": {
      "post": {
        "description": "从本地路径导入 skill 包（整目录复制进库、默认启用）。",
        "operationId": "import_one_api_skills_import_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SkillImportRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SkillImportResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDetail"
                }
              }
            },
            "description": "路径不存在 / 格式不合法"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDetail"
                }
              }
            },
            "description": "同名 skill 已存在（重名不合并）"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Import One",
        "tags": [
          "Skill 库"
        ]
      }
    },
    "/api/skills/{name}": {
      "delete": {
        "description": "删除 skill（整目录移除）。",
        "operationId": "remove_api_skills__name__delete",
        "parameters": [
          {
            "in": "path",
            "name": "name",
            "required": true,
            "schema": {
              "title": "Name",
              "type": "string"
            }
          }
        ],
        "responses": {
